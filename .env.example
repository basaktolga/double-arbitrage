# Copy to .env and fill in. This file + data/ is everything a server needs.

# --- runner
RUN_INTERVAL_MIN=15
SCRAPE_TIMEOUT_MIN=20
DOMAIN_CHECK_EVERY=4
MIN_PROFIT=1
# Push alerts: install the ntfy app and subscribe to this (long, random) topic
NTFY_TOPIC=
# Leave unset when using the bundled `hosted` service; set to your Render URL otherwise
# ARB_FINDER_URL=https://arb-finder.onrender.com
# chrome (x86 servers) | empty = bundled Chromium (ARM servers, e.g. Oracle A1)
BROWSER_CHANNEL=

# --- hosted web app (see hosted/README.md)
APP_PASSWORD=change-me
UPLOAD_KEY=change-me-long-random
ODDSPAPI_KEY=
ANTHROPIC_API_KEY=
